[GENERAL]
polynomialOrder = 8
stopAt = numSteps
numSteps = 0
dt = 0.01

[ELLIPTIC POISSON]
solver = cg+maxiter=20000
residualTol = 1e-12+relative
initialGuess = previous
preconditioner = multigrid
smootherType = RAS+FourthOptChebyshev
coarseGridDiscretization = SEMFEM
coarseSolver = boomerAMG+device
boundaryTypeMap = zeroDirichlet
